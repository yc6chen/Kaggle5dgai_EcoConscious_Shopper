# Environment variables for Eco-Conscious Shopper

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Set to 1 to use Vertex AI, or 0 to use Google AI Studio
GOOGLE_GENAI_USE_VERTEXAI=1

# API Configuration
PORT=8080

# API Keys (DO NOT commit actual keys!)
# Add your API keys here for local development only
# In production, use Google Cloud Secret Manager

# OpenSupplyHub API Key (optional)
# OPENSUPPLYHUB_API_KEY=your_api_key_here

# Application Settings
CACHE_DIR=./cache
LOG_LEVEL=INFO
